{
  "name": "skillora-api",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "./node_modules/.bin/prisma generate",
    "db:migrate": "./node_modules/.bin/prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "start": "node src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "6.17.1",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "pino-http": "10.3.0",
    "prisma": "6.17.1",
    "resend": "4.1.2"
  }
}
